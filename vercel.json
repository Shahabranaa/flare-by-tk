{
  "buildCommand": "pnpm install && pnpm --filter @workspace/flare-restaurant run build",
  "outputDirectory": "artifacts/flare-restaurant/dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR_REPLIT_BACKEND_URL/api/:path*"
    }
  ]
}
